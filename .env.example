NODE_ENV=development
PORT=3000
LOG_LEVEL=info

MONGO_URI=mongodb://127.0.0.1:27017/notifications
REDIS_URL=redis://127.0.0.1:6379

# Run BullMQ workers inside the API process (set false when using `npm run worker`)
RUN_WORKERS=true

# Simulated provider failure rate (0-1) so retries and dead-letter handling can be demoed
SIMULATED_FAILURE_RATE=0.08

# Optional real SMTP. Leave blank to use the simulated email channel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@notifications.local

# Per-user send limits
USER_RATE_LIMIT_POINTS=30
USER_RATE_LIMIT_DURATION=60

# API rate limit
API_RATE_LIMIT_POINTS=120
API_RATE_LIMIT_DURATION=60

# Channel token-bucket limits (tokens per minute)
EMAIL_RATE_LIMIT=80
PUSH_RATE_LIMIT=200
SMS_RATE_LIMIT=20
INAPP_RATE_LIMIT=400
